<?xml version='1.0' encoding='UTF-8'?>
<sdf version='1.9'>
  <model name='x500_dual_cam'>

    <!-- Base drone -->
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Left stereo camera -->
    <include merge='true'>
      <uri>model://mono_cam_left</uri>
      <pose>.12 .10 .242 0 0 0</pose>
    </include>

    <joint name="LeftCameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_left_link</child>
      <pose relative_to="base_link">.12 .10 .242 0 0 0</pose>
    </joint>

    <!-- Right stereo camera -->
    <include merge='true'>
      <uri>model://mono_cam_right</uri>
      <pose>.12 -.10 .242 0 0 0</pose>
    </include>

    <joint name="RightCameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_right_link</child>
      <pose relative_to="base_link">.12 -.10 .242 0 0 0</pose>
    </joint>

  </model>
</sdf>
